    COMBOBOX        IDC_RECORD_METHOD,87,74,57,54,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_CURDIR,32,29,72,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_WINDOWNAME,32,13,72,12,ES_AUTOHSCROLL
    PUSHBUTTON      "선택",IDC_SELWIN,114,13,31,14
    PUSHBUTTON      "클리어",IDC_BUTTON3,241,1,30,14,NOT WS_VISIBLE
    LTEXT           "X",IDC_CROSS1,113,47,8,8,NOT WS_VISIBLE
    LTEXT           "Record Method",IDC_STATIC,88,63,50,8
    LTEXT           "Frame Rate 설정:",IDC_STATIC,4,78,57,10
