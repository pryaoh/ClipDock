IDD_SCREENENCODER_DIALOG DIALOGEX 0, 0, 299, 128
STYLE DS_SYSMODAL | DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "WoW Encoder for Team Yes"
FONT 9, "굴림", 0, 0, 0x0
BEGIN
