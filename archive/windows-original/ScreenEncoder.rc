    COMBOBOX        IDC_SCREENSIZE,32,45,51,53,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "설정",IDC_STATIC,1,0,148,108
    EDITTEXT        IDC_WIDTH,87,46,23,12,ES_AUTOHSCROLL | ES_NUMBER | NOT WS_VISIBLE
    EDITTEXT        IDC_HEIGHT,121,46,23,12,ES_AUTOHSCROLL | ES_NUMBER | NOT WS_VISIBLE
    EDITTEXT        IDC_KEYFRAME,64,61,19,12,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_FRAMERATE,64,76,19,12,ES_AUTOHSCROLL | ES_NUMBER
